# Copy to frontend/.env.local if you need to override defaults: cp .env.example .env.local
# VITE_* values are bundled into public JavaScript. Never put secrets here.

# API base path used by the browser. Default /api/v1 goes through the Vite dev proxy.
VITE_API_BASE_URL=/api/v1
# Dev server only (not exposed to the browser): where the Vite proxy forwards /api.
TENQ_DEV_API_TARGET=http://127.0.0.1:8000
