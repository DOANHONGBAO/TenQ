# Local / development server (plain HTTP on 8080). Rendered to /etc/nginx/conf.d/default.conf,
# replacing the image's default server. Production replaces this file with
# infra/nginx/templates-prod/default.conf.template (HTTPS).

server {
    listen 8080 default_server;
    server_name _;
    include /etc/nginx/conf.d/tenq-server.directives;
    include /etc/nginx/conf.d/tenq-api.locations;
}
