# API settings for Docker Compose. Copy to infra/env/api.env (git-ignored) and fill in.
# Generate each hex key with: python3 -c "import secrets; print(secrets.token_hex(32))"
TENQ_ENV=local
TENQ_LOG_LEVEL=INFO
TENQ_WORD_SELECTION_KEY=
TENQ_SESSION_SECRET=
TENQ_PLAYER_HASH_KEY=
# Must contain the REDIS_PASSWORD from redis.env
TENQ_REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0
# Same value as NGINX_ORIGIN_SECRET in nginx.env: the API trusts X-Real-IP only from nginx.
TENQ_ORIGIN_SECRETS=
TENQ_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TENQ_TURNSTILE_ALLOWED_HOSTNAMES=localhost,127.0.0.1,example.com
TENQ_AI_JUDGE=mock
TENQ_OLLAMA_API_KEY=
TENQ_OLLAMA_MODEL=
TENQ_OLLAMA_THINK=
