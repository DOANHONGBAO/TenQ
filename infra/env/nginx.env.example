# Copy to infra/env/nginx.env (git-ignored).
# Shared secret that Vercel adds as X-Origin-Secret (at least 32 characters). Also set it as
# TENQ_ORIGIN_SECRETS in api.env. Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
NGINX_ORIGIN_SECRET=
# on in production (refuse requests that did not come through Vercel); off for local testing.
NGINX_ENFORCE_ORIGIN=off
# Questions and guesses: 1 request per 2 seconds per client IP by default (30r/m, no burst).
NGINX_ASK_RATE=30r/m
