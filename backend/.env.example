# Copy to backend/.env for local development: cp .env.example .env
# Real .env files are git-ignored. Never put real secrets in this file.

# One of: local | test | production (required)
TENQ_ENV=local
# DEBUG | INFO | WARNING | ERROR
TENQ_LOG_LEVEL=INFO
# Comma-separated browser origins allowed to call the API
TENQ_CORS_ORIGINS=http://localhost:5173
# SQLite file with the vocabulary and pinned daily puzzles (git-ignored, contains secrets)
TENQ_DATABASE_PATH=data/tenq.sqlite3
# Secret key for the daily word schedule: 32 random bytes as 64 hex characters (required).
# Generate your own and keep it private:
#   python -c "import secrets; print(secrets.token_hex(32))"
TENQ_WORD_SELECTION_KEY=
# Signs the anonymous session cookie and derives player hashes (required, must differ from
# the key above). Generate the same way: python -c "import secrets; print(secrets.token_hex(32))"
TENQ_SESSION_SECRET=
# Redis for game state. Local: podman run -d --name tenq-redis -p 127.0.0.1:6379:6379 docker.io/library/redis:7.2-alpine
TENQ_REDIS_URL=redis://127.0.0.1:6379/0
# AI judge: "mock" (default, no network, no key) or "ollama" (real Ollama Cloud API)
TENQ_AI_JUDGE=mock
# Ollama Cloud API key (OLLAMA_API_KEY is also accepted). Never commit it.
TENQ_OLLAMA_API_KEY=
# Model name for direct API calls. Free-plan models are not published: run
#   uv run python -m app.scripts.check_ollama_models --probe <model>
# before choosing one.
TENQ_OLLAMA_MODEL=
# Thinking models (e.g. gpt-oss) need "low", otherwise reasoning can truncate the answer;
# leave empty for models without thinking
TENQ_OLLAMA_THINK=
# Global AI call budget (HTTP attempts, retries included) and concurrency (free plan: 1)
TENQ_AI_DAILY_BUDGET=500
TENQ_AI_HOURLY_BUDGET=80
TENQ_AI_MAX_CONCURRENCY=1
# Derives player and daily IP hashes; must differ from the two keys above (required).
# Generate: python -c "import secrets; print(secrets.token_hex(32))". Do not rotate casually.
TENQ_PLAYER_HASH_KEY=
# Cookie secret rotation: move the old TENQ_SESSION_SECRET here, then set a new one.
TENQ_SESSION_SECRET_PREVIOUS=
# Cloudflare Turnstile. Local: official test secret (always passes, hostname example.com).
TENQ_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TENQ_TURNSTILE_ALLOWED_HOSTNAMES=localhost,127.0.0.1,example.com
# Proxy trust: secret(s) Vercel sends as X-Origin-Secret, comma-separated (current,previous).
# Leave empty locally. Required in production.
TENQ_ORIGIN_SECRETS=
